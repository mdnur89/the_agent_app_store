model User {
  id               String             @id @default(uuid())
  supabase_user_id String?            @unique
  email            String?
  telegram_id      String?            @unique
  username         String?
  is_admin         Boolean            @default(false)
  createdAt        DateTime           @default(now())
  sessions         Session[]
  agents           Agent[]            @relation("AgentOwner")
  linkCodes        TelegramLinkCode[]
}
