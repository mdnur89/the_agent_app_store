DATABASE_URL="postgresql://...pooler.../postgres?pgbouncer=true"
DIRECT_URL="postgresql://...direct.../postgres"
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_JWT_SECRET=""
TELEGRAM_BOT_TOKEN=""
GROQ_API_KEY=""
CORS_ORIGINS="http://localhost:5173"
EMBEDDINGS_ENABLED="true"
FASTEMBED_CACHE_DIR=".fastembed_cache"
EMBEDDING_THREADS="1"
OMP_NUM_THREADS="1"
# Voice: Whisper transcription + Orpheus speech, both via GROQ_API_KEY above.
# Set VOICE_ENABLED=false to run text-only (voice notes then get a polite decline).
VOICE_ENABLED="true"
